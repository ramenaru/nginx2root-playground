{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ramenaru/nginx2root-playground/main/docs/n2rpg.schema.json",
  "title": "n2rpg JSON report",
  "description": "Machine-readable output from n2rpg --format json.",
  "type": "object",
  "required": [
    "tool",
    "version",
    "schema_version",
    "generated_at",
    "target",
    "summary",
    "findings"
  ],
  "properties": {
    "tool": {
      "const": "n2rpg"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_version": {
      "const": "1.1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "config",
        "nginx_version",
        "mode",
        "probe"
      ],
      "properties": {
        "config": {
          "type": "string"
        },
        "nginx_version": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "probe": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "passed",
        "skipped",
        "suppressed",
        "findings",
        "exit_code"
      ],
      "properties": {
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "fail",
        "warn",
        "info",
        "pass",
        "skip"
      ]
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "status",
        "title",
        "detail",
        "fix",
        "ref",
        "suppressed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[0-9]+(-[0-9]+)?$"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "fix": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "suppressed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
